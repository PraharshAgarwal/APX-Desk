# APX Desk Frontend — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit the actual .env.local file

# Backend API URL (local development)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WebSocket URL (same as backend)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Port for the dev server (optional, default 3000)
PORT=3001

# Production examples:
# NEXT_PUBLIC_API_URL=https://api.apxdesk.in/api
# NEXT_PUBLIC_WS_URL=https://api.apxdesk.in
